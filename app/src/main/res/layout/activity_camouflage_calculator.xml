<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Calculator Display Screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvCalcHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#888888"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvCalcDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="56sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Calculator Keypad Grid -->
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="*">

        <TableRow android:layout_marginBottom="12dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcClear"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_margin="4dp"
                android:backgroundTint="#A5A5A5"
                android:text="C"
                android:textColor="#000000"
                android:textSize="24sp"
                app:cornerRadius="40dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcSign"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_margin="4dp"
                android:backgroundTint="#A5A5A5"
                android:text="±"
                android:textColor="#000000"
                android:textSize="24sp"
                app:cornerRadius="40dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcPercent"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_margin="4dp"
                android:backgroundTint="#A5A5A5"
                android:text="%"
                android:textColor="#000000"
                android:textSize="24sp"
                app:cornerRadius="40dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcDivide"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_margin="4dp"
                android:backgroundTint="#FF9F0A"
                android:text="÷"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="40dp" />
        </TableRow>

        <TableRow android:layout_marginBottom="12dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc7"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_margin="4dp"
                android:backgroundTint="#333333"
                android:text="7"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="40dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc8"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_margin="4dp"
                android:backgroundTint="#333333"
                android:text="8"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="40dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc9"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_margin="4dp"
                android:backgroundTint="#333333"
                android:text="9"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="40dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcMultiply"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_margin="4dp"
                android:backgroundTint="#FF9F0A"
                android:text="×"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="40dp" />
        </TableRow>

        <TableRow android:layout_marginBottom="12dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc4"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_margin="4dp"
                android:backgroundTint="#333333"
                android:text="4"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="40dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc5"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_margin="4dp"
                android:backgroundTint="#333333"
                android:text="5"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="40dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc6"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_margin="4dp"
                android:backgroundTint="#333333"
                android:text="6"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="40dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcMinus"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_margin="4dp"
                android:backgroundTint="#FF9F0A"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="40dp" />
        </TableRow>

        <TableRow android:layout_marginBottom="12dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc1"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_margin="4dp"
                android:backgroundTint="#333333"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="40dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc2"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_margin="4dp"
                android:backgroundTint="#333333"
                android:text="2"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="40dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc3"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_margin="4dp"
                android:backgroundTint="#333333"
                android:text="3"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="40dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcPlus"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_margin="4dp"
                android:backgroundTint="#FF9F0A"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="40dp" />
        </TableRow>

        <TableRow>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc0"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_span="2"
                android:layout_margin="4dp"
                android:backgroundTint="#333333"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="40dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcDot"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_margin="4dp"
                android:backgroundTint="#333333"
                android:text="."
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="40dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcEquals"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_margin="4dp"
                android:backgroundTint="#FF9F0A"
                android:text="="
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="40dp" />
        </TableRow>

    </TableLayout>

</LinearLayout>
